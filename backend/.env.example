# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kwh_kanban
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated list of allowed frontend origins for CORS
# Example: http://localhost:5173,http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=

# Optional cron overrides (defaults: clean 0 2 * * *, archive 15 2 * * *, summary 5 0 * * *)
# CRON_ENABLED=false
# CRON_CLEAN_SOFT_DELETED=* * * * *
# CRON_ARCHIVE_TASKS=15 2 * * *
# CRON_DAILY_SUMMARY=5 0 * * *
# SOFT_DELETE_RETENTION_DAYS=30
# If set, overrides days (useful for quick local tests; remove when done):
# SOFT_DELETE_RETENTION_MINUTES=1
# ARCHIVE_TASKS_AFTER_DAYS=90
# If set, overrides days for archive job:
# ARCHIVE_TASKS_AFTER_MINUTES=1

